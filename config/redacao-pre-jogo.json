{
  "version": 2,
  "provider": {
    "name": "openai-responses",
    "endpoint": "https://api.openai.com/v1/responses",
    "api_key_env": "OPENAI_API_KEY",
    "model": "gpt-5.6-luna",
    "reasoning_effort": "low",
    "max_output_tokens": 6000,
    "store": false,
    "timeout_seconds": 120,
    "max_attempts": 2,
    "execute_requires_explicit_flag": true
  },
  "scope": {
    "input_contract_step": 25,
    "input_must_be_clean": true,
    "allow_web_search": false,
    "allow_tools": false,
    "one_model_call_per_article": true,
    "output_directory": "build/pre-jogo/rascunhos-modelo",
    "metadata_directory": "build/pre-jogo/redacao-modelo-metadata"
  },
  "safety": {
    "sources_available_to_model": false,
    "provenance_available_to_model": false,
    "external_urls_allowed": false,
    "research_process_mentions_allowed": false,
    "source_attribution_allowed": false,
    "html_generation_allowed": false,
    "publication_unlock_allowed": false
  },
  "budget": {
    "monthly_target_usd": 10,
    "policy": "hard_conservative_guard",
    "pricing_reference_date": "2026-09-19",
    "input_usd_per_million_tokens": 0.2,
    "output_usd_per_million_tokens": 1.2,
    "max_contract_chars": 80000,
    "max_articles_per_day": 10,
    "note": "Somente redacao final usa OpenAI; pesquisa e extracao factual pagas ficam desativadas."
  }
}
